APP_NAME="SmartCard Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartcard_studio
DB_USERNAME=smartcard
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): send the session cookie over HTTPS only
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SmartCard Studio
SMARTCARD_CONTACT_EMAIL=hello@example.com
# Seed demo users and sample data even when APP_ENV=production (never do this on a live site)
SEED_DEMO_DATA=false

# Exports (PNG/PDF need Chrome or Chromium; CMYK needs Ghostscript)
# Windows: use single quotes, e.g. CHROME_PATH='C:\Program Files\Google\Chrome\Application\chrome.exe'
CHROME_PATH=
CHROME_NO_SANDBOX=true
GHOSTSCRIPT_PATH=
EXPORT_TIMEOUT=120
EXPORT_RETENTION_DAYS=7

# Bulk generator
IMPORT_MAX_ROWS=1000
IMPORT_MAX_FILE_KB=5120
IMPORT_RETENTION_DAYS=7

# Orders
APP_CURRENCY=USD

# Security headers: Content-Security-Policy (on by default) and HSTS (turn on once the site is HTTPS-only)
SECURITY_CSP=true
SECURITY_HSTS=false
# Behind a load balancer or CDN: its IPs/CIDRs (comma-separated) or * when only the proxy can reach the app
TRUSTED_PROXIES=

# Follower counts on digital profiles (all optional). Without a key, type counts in on the profile's Social tab.
# YouTube Data API v3 key: https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=
# GitHub works without a token; a token raises the rate limit.
GITHUB_TOKEN=
# X API v2 bearer token (paid plan needed for user lookups)
X_BEARER_TOKEN=
# Meta Graph API: a long-lived token; Instagram counts also need your own Instagram business account id
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
